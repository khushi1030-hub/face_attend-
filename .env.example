# Copy this file to .env and replace the secret-key placeholder with a generated random key.
DJANGO_SECRET_KEY=replace-with-a-generated-random-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
# Add the HTTPS Preview origin here when needed, for example https://your-preview-host
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_TIME_ZONE=Asia/Kolkata
DJANGO_SECURE_COOKIES=False
FACE_RECOGNITION_TOLERANCE=0.48
MAX_UPLOAD_SIZE_MB=6
